{
	"name": "@onsvisual/robo-embed",
	"homepage": "http://onsdigital.github.io/robo-embed",
	"version": "1.0.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node ./scripts/js-fix",
		"build:preview": "cross-env PUBLIC_APP_ENV=preview vite build",
		"build:data": "node ./scripts/build-data",
		"preview": "vite preview",
		"deploy": "gh-pages -d build -t true",
		"lint": "prettier --ignore-path .gitignore --ignore-path .prettierignore --check .",
		"format": "prettier --ignore-path .gitignore --ignore-path .prettierignore --write ."
	},
	"author": "Ahmad Barclay",
	"license": "MIT",
	"devDependencies": {
		"@onsvisual/robo-utils": "^0.6.1",
		"@onsvisual/svelte-charts": "^0.4.11",
		"@onsvisual/svelte-components": "^1.0.3",
		"@onsvisual/svelte-maps": "^2.0.3",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@turf/bbox": "^6.5.0",
		"cross-env": "^7.0.3",
		"d3-dsv": "latest",
		"d3-format": "^3.1.0",
		"gh-pages": "6.1.1",
		"html2canvas": "^1.4.1",
		"node-html-parser": "^6.1.5",
		"parse-color": "^1.0.0",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^3.5.2",
		"pug": "^3.0.4",
		"simple-statistics": "^7.8.3",
		"svelte": "^5.57.1",
		"topojson-client": "^3.1.0",
		"vite": "^7.3.6"
	},
	"type": "module"
}
