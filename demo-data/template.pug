-// Variables
-// Years come from the population columns in the CSV (p2001, p2002...)
-var years = Object.keys(places[0]).filter(key => /^p\d{4}$/.test(key)).map(key => key.slice(1))
-var cols = years.map(year => `p${year}`)
-var latest_yr = years[years.length - 1]
-var prev_yr = years[years.length - 2]
-var latest_col = cols[cols.length - 1]
-var prev_col = cols[cols.length - 2]
-var first_col = cols[0]
-var region = lookup[place?.parentcd]
-var siblings = place ? places.filterBy("parentcd", place.parentcd) : []
-var uk = lookup["K02000001"]
-// Median ages are shown as whole numbers, so compare the rounded values
-var older = {texts: ["older than", "the same as", "younger than"]}
-var ageCompare = (a, b) => compareTo(Math.round(a), Math.round(b), older)
-var more = {texts: ["more than", "the same as", "less than"]}

-// Metadata for SEO and analytics
section.Meta
    prop.title How the population has changed in your area - ONS
    prop.description Demographic trends in local authorities within the UK
    prop.contentTitle Title for google analytics
    prop.releaseDate 2023-01-01
    prop.lastUpdated 2023-01-01
    prop.outputSeries slugforoutputseries
    prop.contentType robo-journalism

if !place
    section.Header
        prop.title How the population has changed in your area
        prop.label Select a local authority

else
    section.Header
        prop.title How the population has changed #{place.getName("in")}
        prop.label Select another local authority

    section.Highlight
        p In #{latest_yr}, #{place.getName("the")} was #{siblings.getRank(place, latest_col).describe("largest")} local authority in #{region.getName("the")}, with a population of #{place[latest_col].approx()}. Its population #{place[prev_col].describeChange(place[latest_col])} compared with #{prev_yr}, and has #{place[first_col].describeChange(place[latest_col], {texts: ["increased", "decreased", "stayed the same"]})} since #{years[0]}.
    
    section#chart-timeseries.Chart
        prop.chartType line-highlight
        prop.title Largest local authorities #{region.getName("in")}, #{years[0]}-#{latest_yr}
        prop.footer Source: Office for National Statistics
        prop.data= siblings.toData({x: years, y: cols, z: "areanm"})
        prop.selected= place.areanm
        prop.padding-top= 20
        prop.padding-right= 120
        prop.padding-left= 80
        //- Show years without a thousands separator (the default is "2,020")
        prop.xFormatTickString d

    section.Section
        prop.title Population density #{place.getName("in")}
        p In #{latest_yr}, the population density #{place.getName("in")} was #{place.density.format()} people per square kilometre, which was #{place.density.compareTo(region.density, more)} #{region.getName("the")} (#{region.density.format()}), and #{place.density.compareTo(uk.density, more)} the United Kingdom as a whole (#{uk.density.format()}).
    
    section#chart-density.Chart
        prop.chartType bar
        prop.title Densest local authorities #{region.getName("in")}, #{latest_yr}
        prop.footer Source: Office for National Statistics
        prop.data= siblings.top("density", 5).toData({x: "density", y: "areanm"})
        prop.padding-left= 120
        prop.directLabel= true

    section.Section
        prop.title Median age #{place.getName("in")}
        p In #{latest_yr}, the median age #{place.getName("in")} was #{place.age_med.format(".0f")} years, which was #{ageCompare(place.age_med, region.age_med)} #{region.getName("the")} (#{region.age_med.format(".0f")} years), and #{ageCompare(place.age_med, uk.age_med)} the United Kingdom as a whole (#{uk.age_med.format(".0f")} years).

    section#chart-age.Chart
        prop.chartType bar
        prop.xSuffix= " years"
        prop.directLabel= true
        prop.title Oldest local authorities #{region.getName("in")}, #{latest_yr}
        prop.footer Source: Office for National Statistics
        prop.data= siblings.top("age_med", 5).toData({x: "age_med", y: "areanm"})
        prop.padding-left= 120
        prop.padding-right= 10

    section#chart-scatter.Chart
        prop.chartType scatter-highlight
        prop.title Population density and median age of local authorities, #{latest_yr}
        prop.subtitle Each circle is a local authority, sized by its area
        prop.xAxisLabel People per sq km
        prop.yAxisLabel Median age (years)
        prop.footer Source: Office for National Statistics
        prop.data= places.toData({x: "density", y: "age_med", r: "area", areacd: "areacd", areanm: "areanm"})
        prop.height= "500px"
        prop.padding-top= 20
        //- Match the selected area by its code, and label circles with their names on hover
        prop.idKey areacd
        prop.labelKey areanm
        prop.selected= place.areacd
        prop.rKey= "r"
        prop.r= "2|20"

    section#map.Map
        prop.data= siblings.toData({x: "density", areanm: "areanm",areacd:"areacd"})
        prop.selected= place.areacd
        prop.height= 300
        prop.title Density #{place.getName("in")} and other local authorities #{region.getName("in")}
        prop.footer Source: Office for National Statistics
        prop.regioncd= place.parentcd


